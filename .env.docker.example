# Archivo de interpolación de Compose. Copia como .env.docker y usa permisos 600.
# Genera cada valor de forma independiente con: openssl rand -hex 32
POSTGRES_PASSWORD=
CRM_SETUP_TOKEN=
# Puerto servido solo en este equipo. PUBLIC_URL usa este puerto por defecto.
CRM_PORT=8086
# PUBLIC_URL=http://localhost:8086
# 1 solo en una base nueva y aislada de demostración.
SEED_DEMO=0
# Para compose.https.yaml, nombre público con DNS hacia el servidor.
# CRM_DOMAIN=crm.tudominio.com
