# Copia a .env y mantenlo fuera de Git. La URL de SQLite se conserva si DB_PATH no se define.
APP_ENV=local
PORT=8086
BIND_HOST=127.0.0.1
PUBLIC_URL=http://localhost:8086
# DATABASE_URL=postgresql://...
# CRM_MANAGE_SCHEMA=1
# CRM_SETUP_TOKEN=
SEED_DEMO=0

# Cuenta Gmail con verificación en dos pasos y contraseña de aplicación de Google.
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=0
MAIL_FROM_NAME=EcoRuta Madrid
# NOTIFY_EMAIL=
