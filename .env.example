# Opcional. Copia a .env con permisos 600. No lo subas al repositorio.
# Gmail SMTP con una contraseña de aplicación (no la contraseña de tu cuenta).
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=EcoRuta Madrid
# Si no se indica, los avisos de respuestas van a GMAIL_USER.
# NOTIFY_EMAIL=ventas@tudominio.com

# Gmail por defecto: TLS implícito en 465.
# Para STARTTLS en 587: SMTP_SSL=0 y SMTP_PORT=587.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SSL=1

# Arranque nativo en macOS. Compose usa .env.docker para estos ajustes.
# PORT=8080
# PUBLIC_URL=http://localhost:8080
# SEED_DEMO=1
